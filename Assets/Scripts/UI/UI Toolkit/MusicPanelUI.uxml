<ui:UXML xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" editor-extension-mode="False">
    <Style src="project://database/Assets/Scripts/UI/UI%20Toolkit/MusicPanelUI.uss?fileID=7433441132597879392&amp;guid=b2c3d4e5f6a74890ab12cd34ef56ab78&amp;type=3#MusicPanelUI"/>
    <ui:VisualElement name="musicPlayerRoot" class="music-root" style="padding-top: 150px; padding-bottom: 150px;">
        <ui:VisualElement name="trackBox" class="music-track-box">
            <ui:Label name="statusLabel" text="NOW PLAYING" class="music-status" style="-unity-font-definition: url(&quot;project://database/Assets/Fonts/FutureLight-BW15w.ttf?fileID=12800000&amp;guid=23156b98981a2ae47b81ba77d89f0f34&amp;type=3#FutureLight-BW15w&quot;);"/>
            <ui:Label name="trackTitleLabel" text="Loading track..." class="music-title" style="-unity-font-definition: url(&quot;project://database/Assets/Fonts/FutureNowRegular-25Bl.ttf?fileID=12800000&amp;guid=39f20f318685a9c488b3b0c8210c6e89&amp;type=3#FutureNowRegular-25Bl&quot;);"/>
        </ui:VisualElement>
        <ui:VisualElement name="controlsRow" class="music-controls-row">
            <ui:Button name="prevButton" text="A" class="music-btn" style="-unity-font-definition: url(&quot;project://database/Assets/Fonts/FutureLight-BW15w.ttf?fileID=12800000&amp;guid=23156b98981a2ae47b81ba77d89f0f34&amp;type=3#FutureLight-BW15w&quot;); font-size: 50px;"/>
            <ui:Button name="playPauseButton" text="SPACE" class="music-btn music-btn-primary" style="-unity-font-definition: url(&quot;project://database/Assets/Fonts/FutureLight-BW15w.ttf?fileID=12800000&amp;guid=23156b98981a2ae47b81ba77d89f0f34&amp;type=3#FutureLight-BW15w&quot;); font-size: 50px;"/>
            <ui:Button name="nextButton" text="D" class="music-btn" style="-unity-font-definition: url(&quot;project://database/Assets/Fonts/FutureLight-BW15w.ttf?fileID=12800000&amp;guid=23156b98981a2ae47b81ba77d89f0f34&amp;type=3#FutureLight-BW15w&quot;); font-size: 50px;"/>
        </ui:VisualElement>
        <ui:VisualElement name="volumeRow" class="music-volume-row">
            <ui:Button name="volDownButton" text="-" class="music-vol-btn"/>
            <ui:VisualElement name="volumeTrack" class="music-vol-track">
                <ui:VisualElement name="volumeFill" class="music-vol-fill"/>
            </ui:VisualElement>
            <ui:Button name="volUpButton" text="+" class="music-vol-btn"/>
            <ui:Label name="volumeLabel" text="70%" class="music-vol-label"/>
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
