:root {
}

.background {
    background-color: rgb(180, 161, 161);
    background-image: resource("BackgroundSilver");
    width: 100%;
    height: 100%;
    justify-content: center;
    align-self: center;
    align-content: center;
    align-items: center;
    flex-wrap: wrap;
    border-top-width: 0;
    border-right-width: 0;
    border-bottom-width: 0;
    border-left-width: 0;
    padding-top: 60px;
    padding-right: 60px;
    padding-bottom: 60px;
    padding-left: 60px;
    display: flex;
}

.card {
    width: 50%;
    height: 100%;
    background-color: rgb(150, 151, 150);
    align-self: center;
    justify-content: flex-end;
    border-top-left-radius: 20px;
    border-top-right-radius: 20px;
    border-bottom-right-radius: 20px;
    border-bottom-left-radius: 20px;
    opacity: 1;
    align-content: center;
    margin-top: 10px;
    margin-right: 10px;
    margin-bottom: 10px;
    margin-left: 10px;
    padding-top: 15px;
    padding-right: 15px;
    padding-bottom: 15px;
    padding-left: 15px;
    display: flex;
}

.button-style {
    justify-content: flex-end;
    align-self: center;
    width: 80%;
    height: 80%;
    opacity: 1;
    background-color: rgb(0, 0, 0);
    border-top-width: 15px;
    border-right-width: 15px;
    border-bottom-width: 15px;
    border-left-width: 15px;
    border-top-left-radius: 20px;
    border-top-right-radius: 20px;
    border-bottom-right-radius: 20px;
    border-bottom-left-radius: 20px;
    border-left-color: rgb(255, 255, 255);
    border-right-color: rgb(255, 255, 255);
    border-top-color: rgb(255, 255, 255);
    border-bottom-color: rgb(255, 255, 255);
}

.button-style:hover {
    background-color: rgb(255, 253, 123);
}

.unity-image {
    border-top-left-radius: 15px;
    border-top-right-radius: 15px;
    border-bottom-right-radius: 15px;
    border-bottom-left-radius: 15px;
}

.unity-image:hover {
    -unity-background-image-tint-color: rgb(255, 255, 255);
    background-color: rgba(241, 239, 170, 0.392);
    opacity: 1;
}

.text-general {
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    font-size: 70px;
    -unity-font-definition: url("project://database/Assets/fonts/FutureNowRegular-25Bl.ttf?fileID=12800000&guid=39f20f318685a9c488b3b0c8210c6e89&type=3#FutureNowRegular-25Bl");
    background-size: auto auto;
    -unity-text-outline-width: 2px;
    text-shadow: 20px 25px 0 rgb(0, 0, 0);
    white-space: nowrap;
    align-self: center;
    justify-content: center;
    height: 100px;
    align-items: center;
    flex-wrap: wrap;
    align-content: center;
    color: rgb(255, 255, 255);
}

.main-text {
    font-size: 150px;
    -unity-text-align: middle-center;
    -unity-font-definition: url("project://database/Assets/fonts/Overmars-Jpdzj.otf?fileID=12800000&guid=80bacaa6c9a67794a9d1e6b734fcfd75&type=3#Overmars-Jpdzj");
    text-shadow: 25px 0 0 rgba(0, 0, 0, 0);
}

.information {
    background-color: rgba(135, 133, 133, 0.745);
    font-size: 150px;
    -unity-text-align: upper-center;
    align-items: center;
    justify-content: flex-start;
    -unity-font-definition: initial;
    color: rgb(249, 255, 52);
    text-shadow: 20px 15px 0 rgb(0, 0, 0);
    -unity-text-outline-color: rgb(0, 0, 0);
    height: 100%;
    align-self: flex-start;
}

.information-text {
    -unity-font-definition: url("project://database/Assets/fonts/FutureNowRegular-25Bl.ttf?fileID=12800000&guid=39f20f318685a9c488b3b0c8210c6e89&type=3#FutureNowRegular-25Bl");
}

.info-mision {
    color: rgb(255, 255, 255);
    -unity-font-definition: url("project://database/Assets/fonts/PixelywaveTechFuture-7OdJw.otf?fileID=12800000&guid=3091d1e83733f8c49b40b722f76f43f3&type=3#PixelywaveTechFuture-7OdJw");
    font-size: 50px;
    white-space: pre-wrap;
    -unity-text-align: upper-center;
}

.text-references {
    -unity-text-align: upper-right;
    width: 100%;
    font-size: 30px;
    -unity-font-style: bold;
}

.style-button {
    -unity-font-style: normal;
    font-size: 100px;
    -unity-font-definition: url("project://database/Assets/fonts/FutureEdge-G3Zjg.ttf?fileID=12800000&guid=20323de7583e72e4782c50242783d686&type=3#FutureEdge-G3Zjg");
    margin-top: 15px;
    margin-right: 15px;
    margin-bottom: 15px;
    margin-left: 15px;
    padding-top: 15px;
    padding-right: 15px;
    padding-bottom: 15px;
    padding-left: 15px;
    border-top-left-radius: 75px;
    border-top-right-radius: 75px;
    border-bottom-right-radius: 75px;
    border-bottom-left-radius: 75px;
    color: rgb(255, 255, 255);
    background-color: rgb(36, 74, 67);
    background-size: 100% 100%;
    width: 100%;
    background-image: resource("frameOne");
    height: 200px;
}

.resources {
    justify-content: center;
    flex-wrap: wrap;
    flex-direction: row;
    border-top-left-radius: 30px;
    border-top-right-radius: 30px;
    border-bottom-right-radius: 30px;
    border-bottom-left-radius: 30px;
}

.button-resource {
    margin-top: 25px;
    margin-right: 25px;
    margin-bottom: 25px;
    margin-left: 25px;
    background-size: 100% 100%;
    height: 100%;
    border-left-color: rgb(255, 255, 255);
    border-right-color: rgb(255, 255, 255);
    border-top-color: rgb(255, 255, 255);
    border-bottom-color: rgb(255, 255, 255);
    border-top-left-radius: 50px;
    border-top-right-radius: 50px;
    border-bottom-right-radius: 50px;
    border-bottom-left-radius: 50px;
    border-top-width: 5px;
    border-right-width: 5px;
    border-bottom-width: 5px;
    border-left-width: 5px;
}

.card-resource {
    background-size: 350px 100px;
    width: 500px;
    height: 500px;
}

.text-resource {
    width: 100%;
    margin-top: 5px;
    margin-right: 5px;
    margin-bottom: 5px;
    margin-left: 5px;
    font-size: 50px;
    -unity-font-definition: url("project://database/Assets/fonts/PixelywaveTechFuture-7OdJw.otf?fileID=12800000&guid=3091d1e83733f8c49b40b722f76f43f3&type=3#PixelywaveTechFuture-7OdJw");
    color: rgb(255, 255, 255);
    -unity-text-align: upper-center;
}

.scroller {
    height: 100%;
    flex-direction: column;
    flex-wrap: nowrap;
    justify-content: flex-end;
    align-self: flex-start;
    align-items: center;
    flex-grow: 1;
    rotate: 0;
}

.image-resource {
    background-image: url("project://database/Assets/Sprites/sprite1.png?fileID=-195958674&guid=34f6a0807cebb7843b6548a0ebf69ab2&type=3#sprite1_4");
    background-color: rgb(0, 0, 0);
    width: 100%;
    height: 500%;
    flex-wrap: wrap;
    justify-content: flex-end;
    opacity: 0.38;
}

.image-resource:hover {
}

.right {
    flex-grow: 1;
    width: 100%;
    height: 100%;
    align-self: center;
    flex-direction: row;
    align-items: center;
    justify-content: center;
    align-content: center;
    background-color: rgba(9, 10, 20, 0.72);
    border-top-left-radius: 30px;
    border-top-right-radius: 30px;
    border-bottom-right-radius: 30px;
    border-bottom-left-radius: 30px;
}

.resources-title {
    justify-content: center;
    align-self: center;
    width: 100%;
    font-size: 115px;
    -unity-font-style: normal;
    -unity-font-definition: url("project://database/Assets/fonts/FutureNowRegular-25Bl.ttf?fileID=12800000&guid=39f20f318685a9c488b3b0c8210c6e89&type=3#FutureNowRegular-25Bl");
    -unity-text-align: upper-center;
    color: rgb(55, 200, 171);
    -unity-text-outline-width: 0;
    text-shadow: 5px 0 0 rgb(0, 0, 0);
}

.resources-subtitle {
    width: auto;
    font-size: 60px;
    -unity-font-style: normal;
    -unity-font-definition: url("project://database/Assets/fonts/PixelywaveTechFuture-7OdJw.otf?fileID=12800000&guid=3091d1e83733f8c49b40b722f76f43f3&type=3#PixelywaveTechFuture-7OdJw");
    color: rgb(255, 255, 255);
}

.resources-left {
    width: 60%;
    height: 100%;
    flex-direction: row;
    flex-wrap: wrap;
    align-items: flex-start;
    -unity-text-align: upper-center;
    align-self: flex-start;
    justify-content: flex-start;
    align-content: flex-start;
    margin-top: 10px;
    margin-right: 10px;
    margin-bottom: 10px;
    margin-left: 10px;
}

.frame-resource {
    flex-direction: row;
    justify-content: center;
    flex-wrap: wrap;
    border-top-color: rgb(255, 255, 255);
    border-right-color: rgb(255, 255, 255);
    border-bottom-color: rgb(255, 255, 255);
    border-left-color: rgb(255, 255, 255);
    border-top-width: 15px;
    border-right-width: 15px;
    border-bottom-width: 15px;
    border-left-width: 15px;
    border-top-left-radius: 10px;
    border-top-right-radius: 10px;
    border-bottom-right-radius: 10px;
    border-bottom-left-radius: 10px;
    width: 340px;
    height: 340px;
    margin-top: 5px;
    margin-right: 5px;
    margin-bottom: 5px;
    margin-left: 5px;
}

.resource-button {
    flex-direction: column;
    justify-content: center;
    width: 100%;
    height: 100%;
    opacity: 0.68;
    -unity-background-image-tint-color: rgb(70, 60, 60);
    transition-duration: 0.5s;
    transition-timing-function: ease-out;
}

.resource-button:hover {
    -unity-background-image-tint-color: rgb(247, 247, 242);
    opacity: 1;
    scale: 1.05 1.05 1;
    background-color: rgb(255, 255, 255);
}

.sprite-bobsemple {
    background-image: url("project://database/Assets/Sprites/sprite1.png?fileID=-385655791&guid=34f6a0807cebb7843b6548a0ebf69ab2&type=3#sprite1_1");
}

.sprite-superacerin {
    background-image: url("project://database/Assets/Sprites/sprite1.png?fileID=1264682343&guid=34f6a0807cebb7843b6548a0ebf69ab2&type=3#sprite1_3");
}

.sprite-plastimax {
    background-image: url("project://database/Assets/Sprites/sprite1.png?fileID=-195958674&guid=34f6a0807cebb7843b6548a0ebf69ab2&type=3#sprite1_4");
}

.sprite-plastimax-ii {
    background-image: url("project://database/Assets/Sprites/sprite1.png?fileID=1960287262&guid=34f6a0807cebb7843b6548a0ebf69ab2&type=3#sprite1_5");
}

.sprite-aluminium {
    background-image: url("project://database/Assets/Sprites/sprite1.png?fileID=-5600456472141597053&guid=34f6a0807cebb7843b6548a0ebf69ab2&type=3#sprite1_0");
}

.sprite-fibrividrio {
    background-image: url("project://database/Assets/Sprites/sprite1.png?fileID=1170246500&guid=34f6a0807cebb7843b6548a0ebf69ab2&type=3#sprite1_2");
}

.resource-stadistic {
    flex-direction: row;
    width: 100%;
    justify-content: flex-start;
    align-items: center;
    margin-top: 10px;
    margin-bottom: 10px;
}

.resource-stadistic-actions {
    justify-content: center;
}

.resources-right {
    align-self: center;
    align-content: center;
    justify-content: flex-start;
    align-items: center;
    width: 40%;
    -unity-text-align: upper-center;
    height: 100%;
    flex-grow: 1;
    margin-top: 10px;
    margin-right: 10px;
    margin-bottom: 10px;
    margin-left: 10px;
}

.label-stadistic {
    -unity-font-style: bold;
    font-size: 55px;
    -unity-font-definition: url("project://database/Assets/fonts/PixelywaveTechFuture-7OdJw.otf?fileID=12800000&guid=3091d1e83733f8c49b40b722f76f43f3&type=3#PixelywaveTechFuture-7OdJw");
    text-shadow: 15px 25px 0 rgb(0, 0, 0);
    color: rgb(255, 255, 255);
    border-left-color: rgb(22, 22, 22);
    border-right-color: rgb(22, 22, 22);
    border-top-color: rgb(22, 22, 22);
    border-bottom-color: rgb(22, 22, 22);
    -unity-text-outline-color: rgb(0, 0, 0);
    margin-right: 16px;
}

.label-value {
    font-size: 80px;
    -unity-font-definition: url("project://database/Assets/fonts/FutureLight-BW15w.ttf?fileID=12800000&guid=23156b98981a2ae47b81ba77d89f0f34&type=3#FutureLight-BW15w");
    -unity-font-style: bold;
    color: rgb(55, 200, 171);
    text-shadow: 50px 50px 0 rgb(64, 43, 43);
}

.unity-progress-bar__progress {
    background-color: rgb(55, 200, 171);
    height: auto;
    transition-timing-function: ease-out;
}

.unity-progress-bar__title-container {
    -unity-background-image-tint-color: rgb(255, 255, 255);
    min-width: 100%;
    width: 100%;
    flex-direction: row;
    flex-grow: 1;
    flex-shrink: 1;
    justify-content: space-around;
    align-items: flex-start;
    align-self: flex-start;
    align-content: stretch;
    height: 100%;
}

.unity-progress-bar {
    justify-content: center;
    width: 100px;
    flex-grow: 1;
    flex-basis: 0%;
    height: 100%;
    background-size: 100% 100%;
    flex-direction: column;
    align-items: stretch;
    align-self: center;
}

.unity-progress-bar__background {
    background-color: rgb(255, 255, 255);
    height: 100%;
}

.button-main {
    background-color: rgb(55, 200, 171);
    width: auto;
    height: 100px;
    margin-top: 20px;
    margin-right: 20px;
    margin-bottom: 20px;
    margin-left: 20px;
    font-size: 50px;
    -unity-font-definition: url("project://database/Assets/fonts/PixelywaveTechFuture-7OdJw.otf?fileID=12800000&guid=3091d1e83733f8c49b40b722f76f43f3&type=3#PixelywaveTechFuture-7OdJw");
    -unity-font-style: bold;
    justify-content: center;
    -unity-text-align: middle-center;
    padding-top: 50px;
    padding-right: 50px;
    padding-bottom: 50px;
    padding-left: 50px;
    border-top-left-radius: 20px;
    border-top-right-radius: 20px;
    border-bottom-right-radius: 20px;
    border-bottom-left-radius: 20px;
}
