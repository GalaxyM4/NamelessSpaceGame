:root {
}

.background {
    background-color: rgb(180, 161, 161);
    background-image: resource("BackgroundSilver");
    width: 100%;
    height: 100%;
    flex-direction: column;
    flex-wrap: nowrap;
    justify-content: flex-start;
    align-items: stretch;
    padding-top: 40px;
    padding-right: 40px;
    padding-bottom: 40px;
    padding-left: 40px;
    display: flex;
}

.main-text {
    width: 100%;
    height: auto;
    flex-shrink: 0;
    font-size: 90px;
    color: rgb(255, 255, 255);
    -unity-text-align: middle-center;
    -unity-font-definition: url("project://database/Assets/fonts/Overmars-Jpdzj.otf?fileID=12800000&guid=80bacaa6c9a67794a9d1e6b734fcfd75&type=3#Overmars-Jpdzj");
    text-shadow: 10px 10px 0 rgb(0, 0, 0);
    margin-bottom: 20px;
}

.main-content {
    flex-grow: 1;
    flex-shrink: 1;
    min-height: 0;
    width: 100%;
    flex-direction: row;
    flex-wrap: nowrap;
    display: flex;
}

.card {
    flex-grow: 1;
    flex-shrink: 1;
    flex-basis: 0%;
    min-width: 0;
    min-height: 0;
    height: 100%;
    background-color: rgba(0, 0, 0, 0.702);
    justify-content: space-between;
    border-top-left-radius: 20px;
    border-top-right-radius: 20px;
    border-bottom-right-radius: 20px;
    border-bottom-left-radius: 20px;
    margin-top: 10px;
    margin-right: 10px;
    margin-bottom: 10px;
    margin-left: 10px;
    padding-top: 20px;
    padding-right: 20px;
    padding-bottom: 20px;
    padding-left: 20px;
    display: flex;
    overflow: hidden;
}

.button-style {
    justify-content: center;
    align-self: center;
    width: 100%;
    flex-grow: 1;
    flex-shrink: 1;
    min-height: 0;
    background-color: rgb(0, 0, 0);
    border-top-width: 10px;
    border-right-width: 10px;
    border-bottom-width: 10px;
    border-left-width: 10px;
    border-top-left-radius: 20px;
    border-top-right-radius: 20px;
    border-bottom-right-radius: 20px;
    border-bottom-left-radius: 20px;
    border-left-color: rgb(255, 255, 255);
    border-right-color: rgb(255, 255, 255);
    border-top-color: rgb(255, 255, 255);
    border-bottom-color: rgb(255, 255, 255);
    padding-top: 15px;
    padding-right: 15px;
    padding-bottom: 15px;
    padding-left: 15px;
}

.button-style:hover {
    background-color: rgb(255, 253, 123);
}

.mission-button-bg {
    background-image: url("project://database/Assets/Textures/marslike01lf.tga?fileID=2800000&guid=31ddc024002c9414988c6a7312552e1d&type=3#marslike01lf");
}

.mission-image {
    width: 100%;
    height: 100%;
    background-image: resource("curiosity-3d-model");
    -unity-background-scale-mode: scale-to-fit;
    border-top-width: 4px;
    border-right-width: 4px;
    border-bottom-width: 4px;
    border-left-width: 4px;
    border-top-left-radius: 20px;
    border-top-right-radius: 20px;
    border-bottom-right-radius: 20px;
    border-bottom-left-radius: 20px;
}

.unity-image {
    border-top-left-radius: 15px;
    border-top-right-radius: 15px;
    border-bottom-right-radius: 15px;
    border-bottom-left-radius: 15px;
}

.unity-image:hover {
    -unity-background-image-tint-color: rgb(255, 255, 255);
    background-color: rgba(241, 239, 170, 0.392);
    opacity: 1;
}

.text-general {
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    font-size: 100px;
    -unity-font-definition: url("project://database/Assets/fonts/FutureNowRegular-25Bl.ttf?fileID=12800000&guid=39f20f318685a9c488b3b0c8210c6e89&type=3#FutureNowRegular-25Bl");
    -unity-text-outline-width: 2px;
    text-shadow: 10px 10px 0 rgb(0, 0, 0);
    white-space: normal;
    align-self: center;
    justify-content: center;
    height: auto;
    flex-shrink: 0;
    margin-top: 12px;
    color: rgb(255, 255, 255);
}

.information {
    background-color: rgba(135, 133, 133, 0.745);
    -unity-text-align: upper-center;
    align-items: stretch;
    justify-content: space-between;
    color: rgb(249, 255, 52);
    text-shadow: 10px 10px 0 rgb(0, 0, 0);
    -unity-text-outline-color: rgb(0, 0, 0);
    display: flex;
}

.information-text {
    font-size: 120px;
    height: auto;
    flex-shrink: 0;
    -unity-text-align: upper-center;
    -unity-font-definition: url("project://database/Assets/fonts/FutureNowRegular-25Bl.ttf?fileID=12800000&guid=39f20f318685a9c488b3b0c8210c6e89&type=3#FutureNowRegular-25Bl");
    margin-bottom: 10px;
}

.info-mision {
    color: rgb(255, 255, 255);
    -unity-font-definition: url("project://database/Assets/fonts/PixelywaveTechFuture-7OdJw.otf?fileID=12800000&guid=3091d1e83733f8c49b40b722f76f43f3&type=3#PixelywaveTechFuture-7OdJw");
    font-size: 36px;
    white-space: normal;
    -unity-text-align: middle-left;
    flex-grow: 1;
    flex-shrink: 1;
    min-height: 0;
    overflow: hidden;
    text-shadow: 3px 3px 0 rgb(0, 0, 0);
}

.text-references {
    -unity-text-align: upper-right;
    width: 100%;
    height: auto;
    flex-shrink: 0;
    font-size: 22px;
    -unity-font-style: bold;
    color: rgb(255, 255, 255);
    margin-top: 8px;
    margin-bottom: 8px;
}

.style-button {
    -unity-font-style: normal;
    font-size: 64px;
    -unity-font-definition: url("project://database/Assets/fonts/FutureEdge-G3Zjg.ttf?fileID=12800000&guid=20323de7583e72e4782c50242783d686&type=3#FutureEdge-G3Zjg");
    margin-top: 10px;
    padding-top: 10px;
    padding-right: 15px;
    padding-bottom: 10px;
    padding-left: 15px;
    border-top-left-radius: 50px;
    border-top-right-radius: 50px;
    border-bottom-right-radius: 50px;
    border-bottom-left-radius: 50px;
    border-top-width: 4px;
    border-right-width: 4px;
    border-bottom-width: 4px;
    border-left-width: 4px;
    border-top-color: rgb(55, 200, 171);
    border-right-color: rgb(55, 200, 171);
    border-bottom-color: rgb(55, 200, 171);
    border-left-color: rgb(55, 200, 171);
    color: rgb(255, 255, 255);
    background-color: rgb(36, 74, 67);
    background-size: 100% 100%;
    width: 100%;
    background-image: resource("frameOne");
    height: 120px;
    flex-shrink: 0;
    transition-duration: 0.25s;
    transition-timing-function: ease-out;
}

.style-button:hover,
.style-button.is-hovered {
    background-color: rgb(55, 200, 171);
    -unity-background-image-tint-color: rgb(170, 255, 235);
    color: rgb(15, 25, 30);
    scale: 1.04 1.04 1;
    border-top-color: rgb(255, 255, 255);
    border-right-color: rgb(255, 255, 255);
    border-bottom-color: rgb(255, 255, 255);
    border-left-color: rgb(255, 255, 255);
}

.style-button:active {
    scale: 0.98 0.98 1;
    background-color: rgb(35, 160, 135);
}

.panel-hidden {
    display: none;
}

.right {
    flex-grow: 1;
    flex-shrink: 1;
    min-width: 0;
    min-height: 0;
    width: 100%;
    height: 100%;
    flex-direction: row;
    flex-wrap: nowrap;
    align-items: stretch;
    justify-content: space-between;
    background-color: rgba(9, 10, 20, 0.72);
    border-top-left-radius: 30px;
    border-top-right-radius: 30px;
    border-bottom-right-radius: 30px;
    border-bottom-left-radius: 30px;
    padding-top: 20px;
    padding-right: 20px;
    padding-bottom: 20px;
    padding-left: 20px;
}

.resources-left {
    width: 55%;
    height: 100%;
    min-height: 0;
    flex-direction: column;
    flex-wrap: nowrap;
    align-items: stretch;
    justify-content: flex-start;
    margin-right: 15px;
}

.card-resource {
    width: 100%;
    height: 240px;
    flex-shrink: 0;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    margin-bottom: 12px;
}

.button-resource {
    width: 170px;
    height: 170px;
    flex-shrink: 0;
    background-image: url("project://database/Assets/Textures/plain_starfield_1.png?fileID=2800000&guid=625dabdc324a0454baa65d072fc2415e&type=3#plain_starfield_1");
    background-size: 100% 100%;
    border-left-color: rgb(255, 255, 255);
    border-right-color: rgb(255, 255, 255);
    border-top-color: rgb(255, 255, 255);
    border-bottom-color: rgb(255, 255, 255);
    border-top-left-radius: 30px;
    border-top-right-radius: 30px;
    border-bottom-right-radius: 30px;
    border-bottom-left-radius: 30px;
    border-top-width: 5px;
    border-right-width: 5px;
    border-bottom-width: 5px;
    border-left-width: 5px;
    padding-top: 12px;
    padding-right: 12px;
    padding-bottom: 12px;
    padding-left: 12px;
}

.image-resource {
    width: 100%;
    height: 100%;
    -unity-background-scale-mode: scale-to-fit;
}

.text-resource {
    width: 100%;
    height: auto;
    flex-shrink: 0;
    margin-top: 6px;
    font-size: 36px;
    -unity-font-definition: url("project://database/Assets/fonts/PixelywaveTechFuture-7OdJw.otf?fileID=12800000&guid=3091d1e83733f8c49b40b722f76f43f3&type=3#PixelywaveTechFuture-7OdJw");
    color: rgb(255, 255, 255);
    -unity-text-align: middle-center;
}

.equipment-tree {
    flex-grow: 1;
    flex-shrink: 1;
    min-height: 0;
    width: 100%;
    background-color: rgba(20, 24, 34, 0.85);
    border-top-left-radius: 15px;
    border-top-right-radius: 15px;
    border-bottom-right-radius: 15px;
    border-bottom-left-radius: 15px;
    border-top-width: 2px;
    border-right-width: 2px;
    border-bottom-width: 2px;
    border-left-width: 2px;
    border-top-color: rgb(55, 200, 171);
    border-right-color: rgb(55, 200, 171);
    border-bottom-color: rgb(55, 200, 171);
    border-left-color: rgb(55, 200, 171);
}

.equipment-scroll {
    flex-grow: 1;
    flex-shrink: 1;
    min-height: 0;
    width: 100%;
    padding-right: 10px;
}

.section-header {
    width: 100%;
    height: auto;
    font-size: 42px;
    -unity-font-definition: url("project://database/Assets/fonts/FutureNowRegular-25Bl.ttf?fileID=12800000&guid=39f20f318685a9c488b3b0c8210c6e89&type=3#FutureNowRegular-25Bl");
    color: rgb(55, 200, 171);
    -unity-text-align: middle-left;
    margin-top: 14px;
    margin-bottom: 10px;
    padding-left: 6px;
    border-bottom-width: 2px;
    border-bottom-color: rgba(55, 200, 171, 0.5);
}

.module-grid {
    width: 100%;
    height: auto;
    flex-direction: row;
    flex-wrap: wrap;
    justify-content: flex-start;
    align-items: flex-start;
    margin-bottom: 10px;
    overflow: visible;
}

.grid-card {
    width: 31%;
    height: auto;
    flex-direction: column;
    align-items: center;
    justify-content: flex-start;
    background-color: rgba(20, 24, 34, 0.75);
    border-top-width: 2px;
    border-right-width: 2px;
    border-bottom-width: 2px;
    border-left-width: 2px;
    border-top-color: rgba(255, 255, 255, 0.25);
    border-right-color: rgba(255, 255, 255, 0.25);
    border-bottom-color: rgba(255, 255, 255, 0.25);
    border-left-color: rgba(255, 255, 255, 0.25);
    border-top-left-radius: 18px;
    border-top-right-radius: 18px;
    border-bottom-right-radius: 18px;
    border-bottom-left-radius: 18px;
    margin-top: 10px;
    margin-right: 1%;
    margin-bottom: 10px;
    margin-left: 1%;
    padding-top: 10px;
    padding-right: 10px;
    padding-bottom: 10px;
    padding-left: 10px;
    overflow: visible;
    transition-duration: 0.2s;
    transition-timing-function: ease-out;
}

.grid-card:hover,
.grid-card.is-hovered {
    border-top-color: rgb(255, 255, 255);
    border-right-color: rgb(255, 255, 255);
    border-bottom-color: rgb(255, 255, 255);
    border-left-color: rgb(255, 255, 255);
    background-color: rgba(255, 255, 255, 0.92);
}

.grid-card.is-selected {
    border-top-color: rgb(55, 200, 171);
    border-right-color: rgb(55, 200, 171);
    border-bottom-color: rgb(55, 200, 171);
    border-left-color: rgb(55, 200, 171);
    background-color: rgba(55, 200, 171, 0.35);
}

.grid-card-frame {
    width: 140px;
    height: 140px;
    flex-shrink: 0;
    background-image: url("project://database/Assets/Textures/plain_starfield_1.png?fileID=2800000&guid=625dabdc324a0454baa65d072fc2415e&type=3#plain_starfield_1");
    background-size: 100% 100%;
    border-left-color: rgb(255, 255, 255);
    border-right-color: rgb(255, 255, 255);
    border-top-color: rgb(255, 255, 255);
    border-bottom-color: rgb(255, 255, 255);
    border-top-left-radius: 20px;
    border-top-right-radius: 20px;
    border-bottom-right-radius: 20px;
    border-bottom-left-radius: 20px;
    border-top-width: 3px;
    border-right-width: 3px;
    border-bottom-width: 3px;
    border-left-width: 3px;
    padding-top: 8px;
    padding-right: 8px;
    padding-bottom: 8px;
    padding-left: 8px;
    overflow: visible;
}

.grid-card-icon {
    width: 100%;
    height: 100%;
    -unity-background-scale-mode: scale-to-fit;
    opacity: 0.6;
    scale: 1.15 1.15 1;
    transition-duration: 0.25s;
    transition-timing-function: ease-out;
}

.grid-card:hover .grid-card-icon,
.grid-card.is-hovered .grid-card-icon {
    opacity: 1;
    scale: 1.4 1.4 1;
}

.grid-card-label {
    width: 100%;
    height: auto;
    margin-top: 8px;
    font-size: 26px;
    white-space: normal;
    -unity-font-definition: url("project://database/Assets/fonts/PixelywaveTechFuture-7OdJw.otf?fileID=12800000&guid=3091d1e83733f8c49b40b722f76f43f3&type=3#PixelywaveTechFuture-7OdJw");
    color: rgb(255, 255, 255);
    -unity-text-align: middle-center;
    transition-duration: 0.2s;
    transition-timing-function: ease-out;
}

.grid-card:hover .grid-card-label,
.grid-card.is-hovered .grid-card-label {
    color: rgb(20, 24, 34);
}

.resources-right {
    align-self: stretch;
    justify-content: flex-start;
    align-items: center;
    width: 45%;
    height: 100%;
    min-height: 0;
    flex-grow: 1;
    flex-shrink: 1;
    padding-top: 10px;
    padding-right: 15px;
    padding-bottom: 10px;
    padding-left: 15px;
}

.resources-title {
    justify-content: center;
    align-self: center;
    width: 100%;
    height: auto;
    flex-shrink: 0;
    font-size: 95px;
    -unity-font-style: normal;
    -unity-font-definition: url("project://database/Assets/fonts/FutureNowRegular-25Bl.ttf?fileID=12800000&guid=39f20f318685a9c488b3b0c8210c6e89&type=3#FutureNowRegular-25Bl");
    -unity-text-align: upper-center;
    color: rgb(55, 200, 171);
    text-shadow: 5px 0 0 rgb(0, 0, 0);
}

.resources-subtitle {
    width: auto;
    height: auto;
    flex-shrink: 0;
    font-size: 50px;
    -unity-font-style: normal;
    -unity-font-definition: url("project://database/Assets/fonts/PixelywaveTechFuture-7OdJw.otf?fileID=12800000&guid=3091d1e83733f8c49b40b722f76f43f3&type=3#PixelywaveTechFuture-7OdJw");
    color: rgb(255, 255, 255);
    margin-bottom: 16px;
}

.resource-stadistic {
    flex-direction: row;
    width: 100%;
    height: auto;
    flex-shrink: 0;
    justify-content: flex-start;
    align-items: center;
    margin-top: 12px;
    margin-bottom: 12px;
    font-size: 14px;
}

.resource-stadistic-actions {
    justify-content: center;
    flex-wrap: wrap;
    margin-top: auto;
}

.label-stadistic {
    -unity-font-style: bold;
    font-size: 65px;
    flex-shrink: 0;
    -unity-font-definition: url("project://database/Assets/fonts/PixelywaveTechFuture-7OdJw.otf?fileID=12800000&guid=3091d1e83733f8c49b40b722f76f43f3&type=3#PixelywaveTechFuture-7OdJw");
    text-shadow: 5px 5px 0 rgb(0, 0, 0);
    color: rgb(255, 255, 255);
    margin-right: 16px;
}

.label-value {
    font-size: 82px;
    flex-shrink: 1;
    white-space: normal;
    -unity-font-definition: url("project://database/Assets/fonts/FutureLight-BW15w.ttf?fileID=12800000&guid=23156b98981a2ae47b81ba77d89f0f34&type=3#FutureLight-BW15w");
    -unity-font-style: bold;
    color: rgb(55, 200, 171);
    text-shadow: 4px 4px 0 rgb(0, 0, 0);
}

.unity-progress-bar__progress {
    background-color: rgb(55, 200, 171);
    height: 100%;
    transition-timing-function: ease-out;
}

.unity-progress-bar__title-container {
    min-width: 100%;
    width: 100%;
    flex-direction: row;
    flex-grow: 1;
    flex-shrink: 1;
    justify-content: space-around;
    align-items: center;
    height: 100%;
}

.unity-progress-bar {
    justify-content: center;
    width: 100px;
    flex-grow: 1;
    flex-basis: 0%;
    height: 44px;
    flex-direction: column;
    align-items: stretch;
    align-self: center;
}

.unity-progress-bar__background {
    background-color: rgb(255, 255, 255);
    height: 100%;
}

.button-main {
    background-color: rgb(55, 200, 171);
    width: auto;
    height: 90px;
    margin-top: 10px;
    margin-right: 10px;
    margin-bottom: 10px;
    margin-left: 10px;
    font-size: 44px;
    -unity-font-definition: url("project://database/Assets/fonts/PixelywaveTechFuture-7OdJw.otf?fileID=12800000&guid=3091d1e83733f8c49b40b722f76f43f3&type=3#PixelywaveTechFuture-7OdJw");
    -unity-font-style: bold;
    justify-content: center;
    -unity-text-align: middle-center;
    padding-top: 15px;
    padding-right: 40px;
    padding-bottom: 15px;
    padding-left: 40px;
    border-top-left-radius: 20px;
    border-top-right-radius: 20px;
    border-bottom-right-radius: 20px;
    border-bottom-left-radius: 20px;
    transition-duration: 0.2s;
    transition-timing-function: ease-out;
}

.button-main:hover,
.button-main.is-hovered {
    background-color: rgb(90, 235, 205);
    scale: 1.04 1.04 1;
}

.button-exit {
    background-color: rgb(200, 55, 55);
    color: rgb(255, 255, 255);
}

.button-exit:hover,
.button-exit.is-hovered {
    background-color: rgb(235, 85, 85);
    scale: 1.04 1.04 1;
}

.button-launch {
    background-color: rgb(35, 145, 220);
    color: rgb(255, 255, 255);
    margin-left: 10px;
    margin-right: 10px;
}

.button-launch:hover,
.button-launch.is-hovered {
    background-color: rgb(70, 180, 255);
    scale: 1.04 1.04 1;
}

