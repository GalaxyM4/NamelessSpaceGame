}

.tp-radmax {
    background-image: url("project://database/Assets/Sprites/sprite6.png?fileID=-1348647770&guid=09f589012aee1eb4b99649b38126776f&type=3#sprite6_2");
}

.tp-supreme {
    background-image: url("project://database/Assets/Sprites/sprite6.png?fileID=850180623&guid=09f589012aee1eb4b99649b38126776f&type=3#sprite6_3");
}
