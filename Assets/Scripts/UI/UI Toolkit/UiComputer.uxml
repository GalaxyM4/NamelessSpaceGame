<ui:UXML xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" noNamespaceSchemaLocation="../UIElementsSchema/UIElements.xsd" editor-extension-mode="False">
    <Style src="project://database/Assets/Scripts/UI/UI%20Toolkit/UiComputer.uss?fileID=7433441132597879392&amp;guid=75c39eb46fa76e44fb77598b9c818cdf&amp;type=3#UiComputer"/>
    <ui:VisualElement class="background">
        <ui:Label name="screenTitle" text="&lt;A ­ ­ ­ ­ ­ ­ ­  ­ ­ ­ ­ ­ ­ ­ SELECT YOUR MISSION ­ ­ ­ ­ ­ ­ ­  ­ ­ ­ ­ ­ ­ ­ D&gt;" class="main-text"/>
        <ui:VisualElement name="mainContent" class="main-content" style="font-size: 0;">
            <ui:VisualElement name="misionOne" class="card">
                <ui:Button text="" name="MissionButtonImage" class="button-style mission-button-bg" style="-unity-background-scale-mode: scale-and-crop;">
                    <ui:Image style="background-image: resource(&quot;curiosity-3d-model&quot;); height: 70%; width: 70%; right: auto; bottom: 0; justify-content: center; align-items: auto; align-self: center;"/>
                </ui:Button>
                <ui:Label text="Mission #1 - The Collection" name="MissionTitle" class="text-general"/>
            </ui:VisualElement>
            <ui:VisualElement name="information" class="card information">
                <ui:Label text="Information" class="information-text"/>
                <ui:Label text="Since landing on the Red Planet in 2021 to search for signs of ancient life, NASA's Perseverance Mars rover has driven farther and faster than any vehicle on the surface of another world. On Oct. 11, its odometer reached 28.10 miles (45.22 kilometers), beating the 28.06-mile (45.16-kilometer) record of NASA's Opportunity rover (2004-2018). And Perseverance covered that ground in about 5½ years, compared with almost 15 for its predecessor. This mission highlights mineral collection, honoring this milestone from 2021." name="information" class="info-mision"/>
                <ui:Label text="Budget: 900$" name="missionBudgetLabel" class="mission-budget-text"/>
                <ui:Label text="https://science.nasa.gov/mission/mars-2020-perseverance/" name="urlInfo" class="text-references"/>
                <ui:Button text="START MISSION" name="Button" class="style-button"/>
            </ui:VisualElement>
            <ui:VisualElement name="dashboardRight" class="right panel-hidden">
                <ui:VisualElement name="resources-left" class="resources-left">
                    <ui:ScrollView name="equipmentScrollView" class="equipment-scroll"/>
                </ui:VisualElement>
                <ui:VisualElement name="resources-right" class="resources-right">
                    <ui:Label name="resourcesTitle" text="ARMOR" class="resources-title"/>
                    <ui:Label name="selected" text="SELECT ONE" class="resources-subtitle" style="-unity-font-definition: url(&quot;project://database/Assets/fonts/FutureLight-BW15w.ttf?fileID=12800000&amp;guid=23156b98981a2ae47b81ba77d89f0f34&amp;type=3#FutureLight-BW15w&quot;);"/>
                    <ui:VisualElement class="resource-stadistic">
                        <ui:Label name="statLabel" text="Capacity:" class="label-stadistic"/>
                        <ui:ProgressBar name="capacity" low-value="0" high-value="100" value="0" title=""/>
                    </ui:VisualElement>
                    <ui:VisualElement class="resource-stadistic">
                        <ui:Label name="detailLabel" text="Detail:" class="label-stadistic"/>
                        <ui:Label name="weight" text="-" class="label-value"/>
                    </ui:VisualElement>
                    <ui:VisualElement class="resource-stadistic">
                        <ui:Label text="Cost:" class="label-stadistic"/>
                        <ui:Label name="price" text="0.00$" class="label-value"/>
                    </ui:VisualElement>
                    <ui:VisualElement class="resource-stadistic">
                        <ui:Label name="budgetTitleLabel" text="Budget:" class="label-stadistic"/>
                        <ui:Label name="budgetLabel" text="900$ / 900$" class="label-value"/>
                    </ui:VisualElement>
                    <ui:VisualElement class="resource-stadistic resource-stadistic-actions">
                        <ui:Button name="save" text="Select" class="button-main"/>
                        <ui:Button name="launchButton" text="Launch to Mars" class="button-main button-launch panel-hidden"/>
                        <ui:Button name="exitButton" text="Exit" class="button-main button-exit"/>
                    </ui:VisualElement>
                </ui:VisualElement>
            </ui:VisualElement>
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
