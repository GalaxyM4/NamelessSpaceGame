<ui:UXML xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" noNamespaceSchemaLocation="../UIElementsSchema/UIElements.xsd" editor-extension-mode="False">
    <Style src="project://database/Assets/UI%20Toolkit/UIToolKit.uss?fileID=7433441132597879392&amp;guid=bcbf0ced32f1948438e621ff7ed16ba5&amp;type=3#UIToolKit"/>
    <ui:VisualElement class="container">
        <ui:VisualElement name="MenuVisualElement" class="left">
            <ui:Label text="Nameless Space Game" name="Title" class="title"/>
            <ui:VisualElement name="botones">
                <ui:Button text="Jugar" name="play" class="styleButton"/>
                <ui:Button text="Ajustes" name="config" class="styleButton"/>
                <ui:Button text="Creditos" name="credits" class="styleButton"/>
                <ui:Button text="Salir" name="exit" class="styleButton"/>
            </ui:VisualElement>
            <ui:VisualElement name="footer" style="width: 100%; height: auto;"/>
        </ui:VisualElement>
        <ui:VisualElement name="VisualElement" class="right">
            <ui:VisualElement name="settingsPanel" class="menu-panel panel-hidden">
                <ui:Label text="AJUSTES" class="panel-title"/>
                <ui:VisualElement class="panel-content">
                    <ui:Slider label="Volumen Maestro" name="masterVolume" low-value="0" high-value="100" value="80" class="setting-control"/>
                    <ui:Slider label="Sensibilidad" name="sensitivity" low-value="1" high-value="10" value="5" class="setting-control"/>
                    <ui:Toggle label="Pantalla Completa" name="fullscreenToggle" value="true" class="setting-control"/>
                </ui:VisualElement>
            </ui:VisualElement>
            <ui:VisualElement name="creditsPanel" class="menu-panel panel-hidden">
                <ui:Label text="CRÉDITOS" class="panel-title"/>
                <ui:ListView name="creditsList" fixed-item-height="80" class="credits-list"/>
            </ui:VisualElement>
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
