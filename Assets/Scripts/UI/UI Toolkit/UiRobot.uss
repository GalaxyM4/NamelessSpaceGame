:root {
}

.frame {
    border-left-color: rgb(255, 255, 255);
    border-right-color: rgb(255, 255, 255);
    border-top-color: rgb(255, 255, 255);
    border-bottom-color: rgb(255, 255, 255);
    margin-top: 18px;
    margin-right: 18px;
    margin-bottom: 18px;
    margin-left: 18px;
    border-top-width: 10px;
    border-right-width: 10px;
    border-bottom-width: 10px;
    border-left-width: 10px;
    border-top-left-radius: 8px;
    border-top-right-radius: 8px;
    border-bottom-right-radius: 8px;
    border-bottom-left-radius: 8px;
}

.frame-minor {
    margin-top: 20px;
    margin-right: 20px;
    margin-bottom: 20px;
    margin-left: 20px;
    background-color: rgba(0, 0, 0, 0);
    align-self: center;
    justify-content: center;
    align-items: center;
    width: 100%;
    padding-top: 0;
    padding-right: 0;
    padding-bottom: 0;
    padding-left: 0;
}

.corner-bottom-left {
    border-left-color: rgb(255, 255, 255);
    border-bottom-color: rgb(255, 255, 255);
    border-top-width: 0;
    border-right-width: 0;
    border-bottom-width: 10px;
    border-left-width: 10px;
    width: auto;
    height: auto;
    bottom: 0%;
    left: 0%;
}

.corner-bottom-right {
    border-bottom-color: rgb(255, 255, 255);
    border-right-color: rgb(255, 255, 255);
    border-top-width: 10px;
    border-right-width: 10px;
    border-bottom-width: 10px;
    border-left-width: 10px;
    bottom: 0%;
    right: 0%;
}

.corner-top-right {
    border-top-width: 10px;
    border-top-color: rgb(255, 255, 255);
    border-left-color: rgba(0, 0, 0, 0.51);
    border-right-width: 10px;
    border-right-color: rgb(255, 255, 255);
    top: 0;
    right: 0;
    position: relative;
    flex-direction: row;
    margin-top: 0;
    margin-right: 0;
    margin-bottom: 0;
    margin-left: 0;
    padding-top: 15px;
    padding-right: 15px;
    padding-bottom: 15px;
    padding-left: 15px;
    width: auto;
    height: 100%;
}

.corner-top-left {
    border-left-color: rgb(255, 255, 255);
    border-right-color: rgb(255, 255, 255);
    border-top-color: rgb(255, 255, 255);
    border-bottom-color: rgb(255, 255, 255);
    border-left-width: 10px;
    border-top-width: 10px;
    background-position-x: left 0;
    position: absolute;
    left: 0%;
    top: 0%;
}

.corner {
    width: 500px;
    height: 200px;
    position: absolute;
    margin-top: 15px;
    margin-right: 15px;
    margin-bottom: 15px;
    margin-left: 15px;
}

.pointer {
    width: 200px;
    height: 200px;
    border-top-width: 0;
    border-right-width: 0;
    border-bottom-width: 0;
    border-left-width: 0;
    align-self: center;
    justify-content: center;
    align-items: center;
}

.radius-bottom-left {
    border-top-left-radius: 0;
    border-left-color: rgb(34, 106, 255);
    border-right-color: rgb(34, 106, 255);
    border-top-color: rgb(34, 106, 255);
    border-bottom-color: rgb(34, 106, 255);
    border-top-right-radius: 0;
    border-bottom-right-radius: 0;
    border-bottom-left-radius: 5px;
    border-top-width: 5px;
    border-right-width: 5px;
    border-bottom-width: 5px;
    border-left-width: 5px;
}

.radius {
    border-top-width: 5px;
    border-right-width: 5px;
    border-bottom-width: 5px;
    border-left-width: 5px;
    border-top-left-radius: 0;
    border-top-right-radius: 0;
    border-bottom-right-radius: 0;
    border-bottom-left-radius: 0;
    border-left-color: rgb(255, 0, 0);
    border-right-color: rgb(255, 0, 0);
    border-top-color: rgb(255, 0, 0);
    border-bottom-color: rgb(255, 0, 0);
    width: auto;
    height: auto;
}

.percent-battery {
    justify-content: center;
    -unity-text-align: middle-center;
    height: auto;
    width: 40%;
    align-self: center;
    align-items: stretch;
    align-content: center;
    -unity-font-definition: url("project://database/Assets/fonts/FutureEdge-G3Zjg.ttf?fileID=12800000&guid=20323de7583e72e4782c50242783d686&type=3#FutureEdge-G3Zjg");
    font-size: 80px;
    color: rgb(255, 255, 255);
    text-shadow: 5px 0 0 rgb(0, 0, 0);
}

.image-battery {
    width: auto;
    height: auto;
}

.image-alert {
}

.alerts {
    display: flex;
}
