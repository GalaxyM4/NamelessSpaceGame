:root {
}

.frame {
    border-left-color: rgb(255, 255, 255);
    border-right-color: rgb(255, 255, 255);
    border-top-color: rgb(255, 255, 255);
    border-bottom-color: rgb(255, 255, 255);
    margin-top: 18px;
    margin-right: 18px;
    margin-bottom: 18px;
    margin-left: 18px;
    border-top-width: 10px;
    border-right-width: 10px;
    border-bottom-width: 10px;
    border-left-width: 10px;
    border-top-left-radius: 8px;
    border-top-right-radius: 8px;
    border-bottom-right-radius: 8px;
    border-bottom-left-radius: 8px;
}

.frame-minor {
    margin-top: 20px;
    margin-right: 20px;
    margin-bottom: 20px;
    margin-left: 20px;
    background-color: rgba(0, 0, 0, 0);
    align-self: center;
    justify-content: center;
    align-items: center;
    width: 100%;
    padding-top: 0;
    padding-right: 0;
    padding-bottom: 0;
    padding-left: 0;
}

.corner-bottom-left {
    border-left-color: rgb(255, 255, 255);
    border-bottom-color: rgb(255, 255, 255);
    border-top-width: 0;
    border-right-width: 0;
    border-bottom-width: 10px;
    border-left-width: 10px;
    width: auto;
    height: auto;
    bottom: 0%;
    left: 0%;
}

.corner-bottom-right {
    border-bottom-color: rgb(255, 255, 255);
    border-right-color: rgb(255, 255, 255);
    border-top-width: 10px;
    border-right-width: 10px;
    border-bottom-width: 10px;
    border-left-width: 10px;
    bottom: 0%;
    right: 0%;
}

.corner-top-right {
    border-top-width: 10px;
    border-top-color: rgb(255, 255, 255);
    border-left-color: rgba(0, 0, 0, 0.51);
    border-right-width: 10px;
    border-right-color: rgb(255, 255, 255);
    top: 0;
    right: 0;
    position: relative;
    flex-direction: row;
    margin-top: 0;
    margin-right: 0;
    margin-bottom: 0;
    margin-left: 0;
    padding-top: 15px;
    padding-right: 15px;
    padding-bottom: 15px;
    padding-left: 15px;
    width: auto;
    height: 100%;
}

.corner-top-left {
    border-left-color: rgb(255, 255, 255);
    border-right-color: rgb(255, 255, 255);
    border-top-color: rgb(255, 255, 255);
    border-bottom-color: rgb(255, 255, 255);
    border-left-width: 10px;
    border-top-width: 10px;
    background-position-x: left 0;
    position: absolute;
    left: 0%;
    top: 0%;
}

.corner {
    width: 500px;
    height: 200px;
    position: absolute;
    margin-top: 15px;
    margin-right: 15px;
    margin-bottom: 15px;
    margin-left: 15px;
}

.pointer {
    width: 200px;
    height: 200px;
    border-top-width: 0;
    border-right-width: 0;
    border-bottom-width: 0;
    border-left-width: 0;
    align-self: center;
    justify-content: center;
    align-items: center;
}

.radius-bottom-left {
    border-top-left-radius: 0;
    border-left-color: rgb(34, 106, 255);
    border-right-color: rgb(34, 106, 255);
    border-top-color: rgb(34, 106, 255);
    border-bottom-color: rgb(34, 106, 255);
    border-top-right-radius: 0;
    border-bottom-right-radius: 0;
    border-bottom-left-radius: 5px;
    border-top-width: 5px;
    border-right-width: 5px;
    border-bottom-width: 5px;
    border-left-width: 5px;
}

.radius {
    border-top-width: 5px;
    border-right-width: 5px;
    border-bottom-width: 5px;
    border-left-width: 5px;
    border-top-left-radius: 0;
    border-top-right-radius: 0;
    border-bottom-right-radius: 0;
    border-bottom-left-radius: 0;
    border-left-color: rgb(255, 0, 0);
    border-right-color: rgb(255, 0, 0);
    border-top-color: rgb(255, 0, 0);
    border-bottom-color: rgb(255, 0, 0);
    width: auto;
    height: auto;
}

.percent-battery {
    justify-content: center;
    -unity-text-align: middle-center;
    height: auto;
    width: 50%;
    align-self: center;
    align-items: stretch;
    align-content: center;
    -unity-font-definition: url("project://database/Assets/fonts/FutureEdge-G3Zjg.ttf?fileID=12800000&guid=20323de7583e72e4782c50242783d686&type=3#FutureEdge-G3Zjg");
    font-size: 80px;
    color: rgb(255, 255, 255);
    text-shadow: 5px 0 0 rgb(0, 0, 0);
}

.image-battery {
    width: auto;
    height: auto;
}

.image-alert {
}

.alerts {
    display: flex;
}

.alerts-hidden {
    display: none;
}

.signal-distortion-overlay {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    background-color: rgba(18, 28, 36, 0);
}

.low-signal-banner {
    position: absolute;
    top: 40px;
    align-self: center;
    padding-top: 14px;
    padding-bottom: 14px;
    padding-left: 32px;
    padding-right: 32px;
    background-color: rgba(35, 10, 10, 0.86);
    border-top-width: 3px;
    border-right-width: 3px;
    border-bottom-width: 3px;
    border-left-width: 3px;
    border-top-color: rgb(255, 65, 45);
    border-right-color: rgb(255, 65, 45);
    border-bottom-color: rgb(255, 65, 45);
    border-left-color: rgb(255, 65, 45);
    border-top-left-radius: 12px;
    border-top-right-radius: 12px;
    border-bottom-right-radius: 12px;
    border-bottom-left-radius: 12px;
    align-items: center;
    justify-content: center;
}

.low-signal-title {
    font-size: 38px;
    color: rgb(255, 75, 55);
    -unity-font-style: bold;
    -unity-font-definition: url("project://database/Assets/fonts/PixelywaveTechFuture-7OdJw.otf?fileID=12800000&guid=3091d1e83733f8c49b40b722f76f43f3&type=3#PixelywaveTechFuture-7OdJw");
    -unity-text-align: middle-center;
    margin-bottom: 4px;
}

.low-signal-detail {
    font-size: 24px;
    color: rgb(255, 225, 220);
    -unity-font-definition: url("project://database/Assets/fonts/PixelywaveTechFuture-7OdJw.otf?fileID=12800000&guid=3091d1e83733f8c49b40b722f76f43f3&type=3#PixelywaveTechFuture-7OdJw");
    -unity-text-align: middle-center;
}

.pause-container {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    width: 100%;
    height: 100%;
    flex-direction: row;
    flex-wrap: nowrap;
    justify-content: space-between;
    align-items: stretch;
}

.pause-left {
    min-width: 800px;
    max-width: 700px;
    height: 100%;
    background-color: rgb(28, 28, 28);
    justify-content: space-between;
    white-space: normal;
    -unity-text-align: middle-left;
    align-self: flex-start;
    border-right-width: 15px;
    border-left-color: rgb(0, 133, 255);
    border-right-color: rgb(55, 200, 171);
    border-top-color: rgb(255, 255, 255);
    border-bottom-color: rgb(0, 133, 255);
}

.pause-right {
    flex-grow: 1;
    height: 100%;
    background-color: rgba(9, 10, 20, 0.522);
}

.pause-title {
    font-size: 160px;
    -unity-font-definition: url("project://database/Assets/fonts/FutureNowRegular-25Bl.ttf?fileID=12800000&guid=39f20f318685a9c488b3b0c8210c6e89&type=3#FutureNowRegular-25Bl");
    -unity-text-outline-color: rgb(255, 255, 255);
    color: rgb(255, 255, 255);
    overflow: hidden;
    text-overflow: clip;
    -unity-text-align: lower-left;
    height: auto;
    white-space: pre-wrap;
    margin-top: 25px;
    margin-right: 25px;
    margin-bottom: 25px;
    margin-left: 25px;
    text-shadow: 5px 10px 0 rgb(55, 200, 171);
}

.pause-style-button {
    position: relative;
    background-color: rgb(203, 203, 203);
    padding-top: 10px;
    padding-right: 10px;
    padding-bottom: 10px;
    padding-left: 10px;
    -unity-font-definition: url("project://database/Assets/fonts/FutureLight-BW15w.ttf?fileID=12800000&guid=23156b98981a2ae47b81ba77d89f0f34&type=3#FutureLight-BW15w");
    font-size: 85px;
    margin-top: 25px;
    margin-right: 25px;
    margin-bottom: 25px;
    margin-left: 25px;
    border-top-left-radius: 15px;
    border-top-right-radius: 15px;
    border-bottom-right-radius: 15px;
    border-bottom-left-radius: 15px;
    transition-duration: 0.5s;
    transition-timing-function: ease-out-sine;
    -unity-font-style: normal;
}

.pause-style-button:hover {
    background-color: rgb(55, 200, 171);
    transition-timing-function: ease;
    transition-duration: 0.4s;
    translate: 0 -15px;
}
