VisualElement {
    width: 100%;
    height: 100%;
}

.styleButton {
    position: relative;
    background-color: rgb(203, 203, 203);
    top: auto;
    padding-top: 10px;
    padding-right: 10px;
    padding-bottom: 10px;
    padding-left: 10px;
    -unity-font-definition: url("project://database/Assets/fonts/FutureLight-BW15w.ttf?fileID=12800000&guid=23156b98981a2ae47b81ba77d89f0f34&type=3#FutureLight-BW15w");
    font-size: 85px;
    margin-top: 25px;
    margin-right: 25px;
    margin-bottom: 25px;
    margin-left: 25px;
    border-top-left-radius: 15px;
    border-top-right-radius: 15px;
    border-bottom-right-radius: 15px;
    border-bottom-left-radius: 15px;
    transition-duration: 0.5s;
    transition-timing-function: ease-out-sine;
    -unity-font-style: normal;
}

.styleButton:hover {
    width: auto;
    height: auto;
    background-color: rgb(55, 200, 171);
    transition-timing-function: ease;
    transition-duration: 1s;
    rotate: 0;
    translate: 0 -25px;
}

.container {
    flex-direction: row;
    align-self: center;
    flex-wrap: nowrap;
    justify-content: space-between;
    -unity-text-align: upper-left;
    align-items: auto;
    width: 100%;
    height: 100%;
}

.left {
    min-width: 800px;
    max-width: 700px;
    height: 100%;
    background-color: rgb(28, 28, 28);
    justify-content: space-between;
    white-space: normal;
    -unity-text-align: middle-left;
    align-self: flex-start;
    border-right-width: 15px;
    border-left-color: rgb(0, 133, 255);
    border-right-color: rgb(55, 200, 171);
    border-top-color: rgb(255, 255, 255);
    border-bottom-color: rgb(0, 133, 255);
}

.right {
    flex-grow: 1;
    height: 100%;
    align-self: center;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    align-content: center;
    padding-top: 40px;
    padding-right: 40px;
    padding-bottom: 40px;
    padding-left: 40px;
    background-color: rgba(9, 10, 20, 0.522);
}

.title {
    font-size: 160px;
    -unity-font-definition: url("project://database/Assets/fonts/FutureNowRegular-25Bl.ttf?fileID=12800000&guid=39f20f318685a9c488b3b0c8210c6e89&type=3#FutureNowRegular-25Bl");
    -unity-text-outline-color: rgb(255, 255, 255);
    color: rgb(255, 255, 255);
    overflow: hidden;
    text-overflow: clip;
    width: initial;
    -unity-text-align: lower-left;
    height: auto;
    white-space: pre-wrap;
    margin-top: 25px;
    margin-right: 25px;
    margin-bottom: 25px;
    margin-left: 25px;
    text-shadow: 5px 10px 0 rgb(55, 200, 171);
}

.menu-panel {
    width: 100%;
    height: 100%;
    flex-direction: column;
    justify-content: flex-start;
    align-items: stretch;
    background-color: rgba(28, 28, 28, 0.85);
    border-top-width: 4px;
    border-right-width: 4px;
    border-bottom-width: 4px;
    border-left-width: 4px;
    border-top-color: rgb(55, 200, 171);
    border-right-color: rgb(55, 200, 171);
    border-bottom-color: rgb(55, 200, 171);
    border-left-color: rgb(55, 200, 171);
    border-top-left-radius: 20px;
    border-top-right-radius: 20px;
    border-bottom-right-radius: 20px;
    border-bottom-left-radius: 20px;
    padding-top: 30px;
    padding-right: 40px;
    padding-bottom: 30px;
    padding-left: 40px;
}

.panel-hidden {
    display: none;
}

.panel-title {
    width: 100%;
    height: auto;
    font-size: 100px;
    -unity-font-definition: url("project://database/Assets/fonts/FutureNowRegular-25Bl.ttf?fileID=12800000&guid=39f20f318685a9c488b3b0c8210c6e89&type=3#FutureNowRegular-25Bl");
    -unity-text-align: upper-center;
    color: rgb(55, 200, 171);
    text-shadow: 5px 0 0 rgb(0, 0, 0);
    margin-bottom: 30px;
}

.panel-content {
    flex-grow: 1;
    flex-direction: column;
    justify-content: flex-start;
    height: auto;
}

.setting-control {
    height: auto;
    margin-top: 15px;
    margin-bottom: 15px;
    font-size: 48px;
    -unity-font-definition: url("project://database/Assets/fonts/PixelywaveTechFuture-7OdJw.otf?fileID=12800000&guid=3091d1e83733f8c49b40b722f76f43f3&type=3#PixelywaveTechFuture-7OdJw");
    color: rgb(255, 255, 255);
}

.credits-list {
    flex-grow: 1;
    width: 100%;
}

.credits-item {
    height: auto;
    font-size: 46px;
    -unity-font-definition: url("project://database/Assets/fonts/FutureLight-BW15w.ttf?fileID=12800000&guid=23156b98981a2ae47b81ba77d89f0f34&type=3#FutureLight-BW15w");
    color: rgb(255, 255, 255);
    -unity-text-align: middle-left;
    padding-left: 16px;
    padding-right: 16px;
}
