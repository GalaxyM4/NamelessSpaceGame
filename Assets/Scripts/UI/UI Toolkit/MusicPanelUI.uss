.music-root {
    width: 100%;
    height: 100%;
    background-color: rgb(10, 14, 22);
    padding: 48px;
    justify-content: space-between;
    align-items: center;
    border-width: 6px;
    border-color: rgba(90, 200, 250, 0.35);
}

.music-header {
    font-size: 28px;
    color: rgba(130, 210, 255, 0.75);
    -unity-font-style: bold;
    letter-spacing: 4px;
    -unity-text-align: middle-center;
}

.music-track-box {
    width: 90%;
    padding: 36px 24px;
    background-color: rgba(255, 255, 255, 0.04);
    border-radius: 16px;
    border-width: 2px;
    border-color: rgba(255, 255, 255, 0.12);
    align-items: center;
    justify-content: center;
}

.music-status {
    font-size: 24px;
    color: rgb(90, 220, 160);
    margin-bottom: 12px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
}

.music-title {
    font-size: 56px;
    color: rgb(245, 248, 255);
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    white-space: normal;
}

.music-controls-row {
    flex-direction: row;
    align-items: center;
    justify-content: center;
    width: 90%;
}

.music-btn {
    min-width: 180px;
    height: 96px;
    margin-left: 16px;
    margin-right: 16px;
    padding-left: 28px;
    padding-right: 28px;
    font-size: 34px;
    -unity-font-style: bold;
    color: rgb(240, 248, 255);
    background-color: rgba(255, 255, 255, 0.08);
    border-width: 3px;
    border-color: rgba(130, 210, 255, 0.45);
    border-radius: 14px;
}

.music-btn:hover {
    background-color: rgba(90, 200, 250, 0.25);
    border-color: rgb(130, 220, 255);
}

.music-btn-primary {
    min-width: 280px;
    background-color: rgba(90, 200, 250, 0.18);
    border-color: rgb(90, 200, 250);
}

.music-volume-row {
    flex-direction: row;
    align-items: center;
    justify-content: center;
    width: 85%;
}

.music-vol-btn {
    width: 84px;
    height: 72px;
    font-size: 40px;
    -unity-font-style: bold;
    color: rgb(240, 248, 255);
    background-color: rgba(255, 255, 255, 0.08);
    border-width: 2px;
    border-color: rgba(255, 255, 255, 0.25);
    border-radius: 12px;
}

.music-vol-track {
    flex-grow: 1;
    height: 28px;
    margin-left: 20px;
    margin-right: 20px;
    background-color: rgba(255, 255, 255, 0.12);
    border-radius: 14px;
    overflow: hidden;
    flex-direction: row;
}

.music-vol-fill {
    height: 100%;
    width: 70%;
    background-color: rgb(90, 200, 250);
    border-radius: 14px;
}

.music-vol-label {
    width: 110px;
    font-size: 32px;
    color: rgba(240, 248, 255, 0.9);
    -unity-font-style: bold;
    -unity-text-align: middle-right;
}

.music-footer {
    font-size: 22px;
    color: rgba(255, 255, 255, 0.45);
    -unity-text-align: middle-center;
}
