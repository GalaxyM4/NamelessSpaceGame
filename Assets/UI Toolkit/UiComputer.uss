:root {
}

.background {
    background-color: rgb(180, 161, 161);
    background-image: resource("BackgroundSilver");
    width: 100%;
    height: 100%;
    justify-content: center;
    align-self: center;
    align-content: center;
    align-items: center;
    flex-wrap: wrap;
    border-top-width: 0;
    border-right-width: 0;
    border-bottom-width: 0;
    border-left-width: 0;
    padding-top: 60px;
    padding-right: 60px;
    padding-bottom: 60px;
    padding-left: 60px;
}

.card {
    width: 50%;
    height: 100%;
    background-color: rgb(150, 151, 150);
    align-self: center;
    justify-content: flex-end;
    border-top-left-radius: 20px;
    border-top-right-radius: 20px;
    border-bottom-right-radius: 20px;
    border-bottom-left-radius: 20px;
    opacity: 1;
    align-content: center;
    margin-top: 10px;
    margin-right: 10px;
    margin-bottom: 10px;
    margin-left: 10px;
    padding-top: 15px;
    padding-right: 15px;
    padding-bottom: 15px;
    padding-left: 15px;
}

.button-style {
    justify-content: flex-end;
    align-self: center;
    width: 80%;
    height: 80%;
    opacity: 1;
    background-color: rgb(0, 0, 0);
    border-top-width: 15px;
    border-right-width: 15px;
    border-bottom-width: 15px;
    border-left-width: 15px;
    border-top-left-radius: 20px;
    border-top-right-radius: 20px;
    border-bottom-right-radius: 20px;
    border-bottom-left-radius: 20px;
    border-left-color: rgb(255, 255, 255);
    border-right-color: rgb(255, 255, 255);
    border-top-color: rgb(255, 255, 255);
    border-bottom-color: rgb(255, 255, 255);
}

.button-style:hover {
    background-color: rgb(255, 253, 123);
}

.unity-image {
    border-top-left-radius: 15px;
    border-top-right-radius: 15px;
    border-bottom-right-radius: 15px;
    border-bottom-left-radius: 15px;
}

.unity-image:hover {
    -unity-background-image-tint-color: rgb(255, 255, 255);
    background-color: rgba(241, 239, 170, 0.392);
    opacity: 1;
}

.text-general {
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    font-size: 70px;
    -unity-font-definition: url("project://database/Assets/fonts/FutureNowRegular-25Bl.ttf?fileID=12800000&guid=39f20f318685a9c488b3b0c8210c6e89&type=3#FutureNowRegular-25Bl");
    background-size: auto auto;
    -unity-text-outline-width: 2px;
    text-shadow: 20px 25px 0 rgb(0, 0, 0);
    white-space: nowrap;
    align-self: center;
    justify-content: center;
    height: 100px;
    align-items: center;
    flex-wrap: wrap;
    align-content: center;
    color: rgb(255, 255, 255);
}

.main-text {
    font-size: 150px;
    -unity-text-align: middle-center;
    -unity-font-definition: url("project://database/Assets/fonts/Overmars-Jpdzj.otf?fileID=12800000&guid=80bacaa6c9a67794a9d1e6b734fcfd75&type=3#Overmars-Jpdzj");
    text-shadow: 25px 0 0 rgba(0, 0, 0, 0);
}

.information {
    background-color: rgba(135, 133, 133, 0.745);
    font-size: 150px;
    -unity-text-align: upper-center;
    align-items: center;
    justify-content: flex-start;
    -unity-font-definition: initial;
    color: rgb(249, 255, 52);
    text-shadow: 20px 15px 0 rgb(0, 0, 0);
    -unity-text-outline-color: rgb(0, 0, 0);
    height: 100%;
    align-self: flex-start;
}

.information-text {
    -unity-font-definition: url("project://database/Assets/fonts/FutureNowRegular-25Bl.ttf?fileID=12800000&guid=39f20f318685a9c488b3b0c8210c6e89&type=3#FutureNowRegular-25Bl");
}

.info-mision {
    color: rgb(255, 255, 255);
    -unity-font-definition: url("project://database/Assets/fonts/PixelywaveTechFuture-7OdJw.otf?fileID=12800000&guid=3091d1e83733f8c49b40b722f76f43f3&type=3#PixelywaveTechFuture-7OdJw");
    font-size: 50px;
    white-space: pre-wrap;
    -unity-text-align: upper-center;
}

.text-references {
    -unity-text-align: upper-right;
    width: 100%;
    font-size: 30px;
    -unity-font-style: bold;
}

.style-button {
    -unity-font-style: normal;
    font-size: 100px;
    -unity-font-definition: url("project://database/Assets/fonts/FutureEdge-G3Zjg.ttf?fileID=12800000&guid=20323de7583e72e4782c50242783d686&type=3#FutureEdge-G3Zjg");
    margin-top: 15px;
    margin-right: 15px;
    margin-bottom: 15px;
    margin-left: 15px;
    padding-top: 15px;
    padding-right: 15px;
    padding-bottom: 15px;
    padding-left: 15px;
    border-top-left-radius: 75px;
    border-top-right-radius: 75px;
    border-bottom-right-radius: 75px;
    border-bottom-left-radius: 75px;
    color: rgb(255, 255, 255);
    background-color: rgb(36, 74, 67);
    background-size: 100% 100%;
    width: 100%;
    background-image: resource("frameOne");
    height: 200px;
}
