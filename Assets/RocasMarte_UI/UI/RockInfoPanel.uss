/* RockInfoPanel.uss — metal cepillado + zonas negras + texto verde agua. Referencia 1920 × 1080.
   Las fuentes las asigna RockInfoUI.cs (clases f-title, f-head, f-label, f-value, f-body, f-italic):
   primero las tuyas (Resources/Fonts) y, si faltan, las libres (Resources/Fonts/Libres). */

:root {
    --aqua: #3DF5D0;
    --aqua-soft: #8FFBE6;
    --aqua-dim: #23A58D;
    --aqua-deep: #0E3B34;
    --black: #040606;
    --black-soft: rgba(6, 10, 11, 0.95);
    --steel-edge: #D4DADE;
    --steel-dark: #4A5156;
}

.root { position: absolute; left: 0; top: 0; right: 0; bottom: 0; align-items: center; justify-content: center; }

/* ---------- ventana ---------- */
.panel {
    width: 1240px;
    padding: 16px;
    background-image: url("../Textures/UI_MetalFrame.png");
    -unity-slice-left: 40; -unity-slice-right: 40; -unity-slice-top: 40; -unity-slice-bottom: 40;
    border-width: 2px;
    border-color: var(--steel-edge) var(--steel-dark) var(--steel-dark) var(--steel-edge);
    border-radius: 6px;
    opacity: 1;
    translate: 0 0;
    transition-property: opacity, translate;
    transition-duration: 0.2s, 0.2s;
    transition-timing-function: ease-out-cubic, ease-out-cubic;
}
.panel--hidden { opacity: 0; translate: 0 28px; }

/* ---------- cabecera ---------- */
.panel__header {
    flex-direction: row;
    align-items: stretch;
    height: 104px;
    padding: 12px 16px;
    margin-bottom: 12px;
    background-image: url("../Textures/UI_MetalHeader.png");
    -unity-background-scale-mode: stretch-to-fill;
    border-width: 1px;
    border-color: var(--steel-dark);
    border-radius: 3px;
}
.header__titles {
    flex-grow: 1;
    justify-content: center;
    padding: 4px 18px;
    background-color: var(--black);
    border-left-width: 5px;
    border-left-color: var(--aqua);
}
.title {
    font-size: 44px;
    color: var(--aqua);
    letter-spacing: 6px;
    margin: 0; padding: 0;
}
.subtitle {
    font-size: 21px;
    color: var(--aqua-soft);
    letter-spacing: 1px;
    margin: 0; padding: 0;
    opacity: 0.85;
}
.header__tag {
    width: 230px;
    margin-left: 12px;
    padding: 10px 14px;
    justify-content: center;
    background-color: var(--black);
    border-width: 1px;
    border-color: var(--aqua-deep);
}
.tag__label { font-size: 15px; color: var(--aqua-soft); letter-spacing: 1px; margin: 0; padding: 0; }
.tag__value { font-size: 17px; color: var(--aqua); margin: 4px 0 0 0; padding: 0; }
.close-button {
    width: 80px;
    margin: 0 0 0 12px;
    font-size: 30px;
    color: var(--aqua);
    background-color: var(--black);
    border-width: 2px;
    border-color: var(--aqua-dim);
    border-radius: 4px;
}
.close-button:hover { border-color: var(--aqua); background-color: #0A1C19; }
.close-button:active { background-color: var(--aqua-deep); }

/* ---------- cuerpo en 3 columnas ---------- */
.panel__body { flex-direction: row; align-items: stretch; height: 440px; }
.column {
    background-color: var(--black-soft);
    border-width: 1px;
    border-color: var(--steel-dark);
    border-top-width: 2px;
    border-top-color: var(--aqua-dim);
    border-radius: 3px;
    padding: 16px 20px;
}
.column--scan   { width: 372px; margin-right: 12px; }
.column--data   { flex-grow: 1; flex-basis: 0; margin-right: 12px; }
.column--meters { flex-grow: 1; flex-basis: 0; }

.section-title {
    font-size: 16px;
    color: var(--aqua);
    letter-spacing: 4px;
    padding-bottom: 8px;
    margin: 0 0 12px 0;
    border-bottom-width: 1px;
    border-bottom-color: var(--aqua-deep);
}

/* ---------- escaneo 3D ---------- */
.scan-view {
    width: 330px; height: 300px;
    align-self: center;
    background-color: var(--black);
    border-width: 1px;
    border-color: var(--aqua-deep);
    overflow: hidden;
}
.scan-grid {
    position: absolute; left: 0; top: 0; right: 0; bottom: 0;
    background-image: url("../Textures/UI_ScanGrid.png");
    -unity-background-scale-mode: scale-and-crop;
    opacity: 0.55;
}
.scan-image {
    position: absolute; left: 6px; top: 6px; right: 6px; bottom: 6px;
    -unity-background-scale-mode: scale-to-fit;
}
.scan-line {
    position: absolute; left: 0; right: 0; top: 0; height: 2px;
    background-color: rgba(61, 245, 208, 0.45);
}
.corner { position: absolute; width: 18px; height: 18px; border-color: var(--aqua); }
.corner--tl { left: 6px; top: 6px; border-left-width: 2px; border-top-width: 2px; }
.corner--tr { right: 6px; top: 6px; border-right-width: 2px; border-top-width: 2px; }
.corner--bl { left: 6px; bottom: 6px; border-left-width: 2px; border-bottom-width: 2px; }
.corner--br { right: 6px; bottom: 6px; border-right-width: 2px; border-bottom-width: 2px; }
.scan-info { flex-direction: row; justify-content: space-between; align-items: center; margin-top: 12px; }
.scan-info__value { font-size: 20px; color: var(--aqua); margin: 0; padding: 0; }

/* ---------- características ---------- */
.row { margin-bottom: 14px; }
.row__label { font-size: 17px; color: var(--aqua-soft); letter-spacing: 1px; margin: 0; padding: 0; }
.row__value {
    font-size: 20px;
    color: var(--aqua);
    white-space: normal;
    margin: 3px 0 0 0; padding: 0;
}

/* ---------- medidores ---------- */
.meter { margin-bottom: 16px; }
.meter__head { flex-direction: row; justify-content: space-between; align-items: flex-end; margin-bottom: 6px; }
.meter__label { font-size: 17px; color: var(--aqua-soft); letter-spacing: 1px; margin: 0; padding: 0; }
.meter__num { font-size: 18px; color: var(--aqua); margin: 0; padding: 0; }
.meter__bar { flex-direction: row; height: 18px; }
.seg {
    flex-grow: 1;
    margin-right: 5px;
    background-color: #0B1F1B;
    border-width: 1px;
    border-color: var(--aqua-deep);
    border-radius: 2px;
}
.seg--last { margin-right: 0; }
.seg--on { background-color: var(--aqua); border-color: #B9FFF1; }
.meter__note {
    font-size: 19px;
    color: var(--aqua-soft);
    white-space: normal;
    margin: 8px 0 0 0;
    opacity: 0.9;
}

/* ---------- descripción y pie ---------- */
.panel__description {
    margin-top: 12px;
    padding: 14px 20px;
    background-color: var(--black-soft);
    border-left-width: 5px;
    border-left-color: var(--aqua);
    border-radius: 3px;
}
.description { font-size: 20px; color: var(--aqua); white-space: normal; margin: 0; padding: 0; }
.panel__footer { flex-direction: row; justify-content: space-between; margin-top: 10px; padding: 0 8px; }
.footer__text { font-size: 15px; color: #0A1414; letter-spacing: 1px; margin: 0; padding: 0; }

/* ---------- aviso "E ANALIZAR" ---------- */
.prompt {
    position: absolute;
    bottom: 11%;
    align-self: center;
    flex-direction: row;
    align-items: center;
    padding: 8px 20px 8px 8px;
    background-color: var(--black-soft);
    border-width: 2px;
    border-color: var(--steel-edge) var(--steel-dark) var(--steel-dark) var(--steel-edge);
    border-radius: 4px;
    opacity: 1;
    transition-property: opacity;
    transition-duration: 0.15s;
}
.prompt--hidden { opacity: 0; }
.prompt__key {
    width: 44px; height: 44px;
    margin-right: 14px;
    font-size: 26px;
    color: var(--black);
    background-color: var(--aqua);
    border-radius: 3px;
    -unity-text-align: middle-center;
}
.prompt__text { font-size: 20px; color: var(--aqua); letter-spacing: 3px; }
