<ui:UXML xmlns:ui="UnityEngine.UIElements" editor-extension-mode="False">
    <Style src="MissionUI.uss" />
    <ui:VisualElement name="root" class="root" picking-mode="Ignore">

        <!-- HUD durante la misión -->
        <ui:VisualElement name="hud" class="hud" picking-mode="Ignore">
            <ui:Label name="hud-title" text="MISIÓN" class="hud__title f-head" />
            <ui:Label name="hud-timer" text="00:00" class="hud__timer f-title" />
            <ui:VisualElement name="hud-objectives" class="hud__objectives" picking-mode="Ignore" />
        </ui:VisualElement>

        <!-- mensajes breves -->
        <ui:VisualElement name="messages" class="messages" picking-mode="Ignore" />

        <!-- perforación (interactor provisional) -->
        <ui:VisualElement name="drill" class="drill drill--hidden" picking-mode="Ignore">
            <ui:Label name="drill-text" text="Mantén [R] para perforar" class="drill__text f-body" />
            <ui:VisualElement class="drill__bar"><ui:VisualElement name="drill-fill" class="drill__fill" /></ui:VisualElement>
        </ui:VisualElement>
        <ui:Label name="tubes" text="TUBOS 0/10" class="tubes f-body" picking-mode="Ignore" />

        <!-- Briefing -->
        <ui:VisualElement name="briefing" class="overlay">
            <ui:VisualElement class="card">
                <ui:Label text="BRIEFING DE MISIÓN" name="briefing-header" class="card__kicker f-head" />
                <ui:Label name="briefing-title" text="Título" class="card__title f-title" />
                <ui:Label name="briefing-desc" text="Descripción" class="card__desc f-body" />
                <ui:Label text="OBJETIVOS" name="briefing-obj-header" class="section f-head" />
                <ui:VisualElement name="briefing-objectives" class="obj-list" />
                <ui:Label name="briefing-limit" text="" class="card__note f-body" />
                <ui:Label name="briefing-record" text="Sin marca previa" class="card__note f-body" />
                <ui:VisualElement class="buttons">
                    <ui:Button name="btn-start" text="COMENZAR" class="btn btn--primary f-head" />
                    <ui:Button name="btn-briefing-exit" text="SALIR" class="btn f-head" />
                </ui:VisualElement>
            </ui:VisualElement>
        </ui:VisualElement>

        <!-- Resultados -->
        <ui:VisualElement name="results" class="overlay">
            <ui:VisualElement class="card card--results">
                <ui:Label name="res-status" text="MISIÓN COMPLETADA" class="card__kicker f-head" />
                <ui:Label name="res-title" text="Título" class="card__title f-title" />
                <ui:VisualElement class="res-body">
                    <ui:VisualElement class="res-left">
                        <ui:Label name="res-grade" text="A" class="grade f-title" />
                        <ui:Label name="res-record" text="¡Nuevo récord!" class="record f-head" />
                    </ui:VisualElement>
                    <ui:VisualElement class="res-right">
                        <ui:Label name="res-time-label" text="TIEMPO" class="section f-head" />
                        <ui:Label name="res-time" text="00:00.00" class="res-time f-title" />
                        <ui:Label name="res-thresholds" text="" class="res-thresholds f-body" />
                        <ui:Label name="res-score-label" text="PUNTAJE" class="section f-head" />
                        <ui:VisualElement name="res-score" class="score" />
                        <ui:Label name="res-samples-label" text="MUESTRAS" class="section f-head" />
                        <ui:VisualElement name="res-objectives" class="obj-list" />
                    </ui:VisualElement>
                </ui:VisualElement>
                <ui:VisualElement class="buttons">
                    <ui:Button name="btn-retry" text="REINTENTAR" class="btn f-head" />
                    <ui:Button name="btn-next" text="SIGUIENTE MISIÓN" class="btn btn--primary f-head" />
                    <ui:Button name="btn-exit" text="SALIR" class="btn f-head" />
                </ui:VisualElement>
            </ui:VisualElement>
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
