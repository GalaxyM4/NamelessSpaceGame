/* MissionUI.uss — missions: black panels, steel borders and aqua text (same style as the rock analysis window). */
:root {
    --aqua: #3DF5D0;
    --aqua-soft: #8FFBE6;
    --aqua-dim: #23A58D;
    --black: rgba(4, 6, 6, 0.92);
    --black-soft: rgba(10, 16, 16, 0.85);
    --steel: #8A9399;
    --steel-dark: #3A4045;
    --ok: #4CE08A;
    --bad: #E0574C;
}

.root { position: absolute; left: 0; top: 0; right: 0; bottom: 0; }
.f-title, .f-head, .f-body { -unity-font-style: normal; }

/* ---------- HUD ---------- */
.hud {
    /* below the white corner and the alert icon of the rover camera UI */
    position: absolute; left: 64px; top: 190px; width: 300px;
    padding: 8px 14px;
    transition-property: top, left; transition-duration: 0.15s;
    background-color: var(--black-soft);
    border-width: 2px; border-radius: 4px;
    border-color: var(--steel) var(--steel-dark) var(--steel-dark) var(--steel);
    border-left-width: 6px; border-left-color: var(--aqua);
}
/* with the analysis panel open the rover camera UI is hidden: the HUD moves up so it does not cover the panel */
.hud--inspecting { top: 24px; left: 24px; }
.hud__title { font-size: 17px; color: var(--aqua-soft); letter-spacing: 1px; }
.hud__timer { font-size: 46px; color: var(--aqua); margin: 0 0 2px 0; }
.hud__objectives { }
.hud-row { flex-direction: row; align-items: center; height: 26px; }
.hud-row__dot { width: 14px; height: 14px; border-radius: 3px; margin-right: 10px; }
.hud-row__label { font-size: 20px; color: #DDEFEB; flex-grow: 1; }
.hud-row__check { width: 22px; height: 22px; display: none; }
.hud-row--done .hud-row__label { color: var(--ok); }
.hud-row--done .hud-row__check { display: flex; }

/* ---------- messages ---------- */
.messages { position: absolute; top: 32px; left: 0; right: 0; align-items: center; }
.msg {
    font-size: 22px; color: var(--aqua);
    padding: 8px 18px; margin-bottom: 6px;
    background-color: var(--black-soft);
    border-width: 1px; border-color: var(--aqua-dim); border-radius: 3px;
    opacity: 1; transition-property: opacity; transition-duration: 0.3s;
}
.msg--out { opacity: 0; }

/* ---------- drilling ---------- */
.drill {
    position: absolute; bottom: 20%; left: 0; right: 0; align-items: center;
    opacity: 1; transition-property: opacity; transition-duration: 0.15s;
}
.drill--hidden { opacity: 0; }
.drill__text {
    font-size: 22px; color: var(--aqua);
    padding: 6px 16px; background-color: var(--black-soft); border-radius: 3px;
}
.drill__bar {
    width: 420px; height: 12px; margin-top: 6px;
    background-color: var(--black-soft);
    border-width: 1px; border-color: var(--aqua-dim); border-radius: 2px;
}
.drill__fill { height: 100%; width: 0%; background-color: var(--aqua); }
.tubes {
    position: absolute; right: 110px; bottom: 130px;   /* above the corners of the rover camera UI */
    font-size: 18px; color: var(--aqua-soft);
    padding: 6px 12px; background-color: var(--black-soft); border-radius: 3px;
}

/* ---------- cards (briefing / results) ---------- */
.overlay {
    position: absolute; left: 0; top: 0; right: 0; bottom: 0;
    background-color: rgba(0, 0, 0, 0.55);
    align-items: center; justify-content: center;
    display: none;
}
.card {
    width: 860px; padding: 30px 40px;
    background-color: var(--black);
    border-width: 3px; border-radius: 6px;
    border-color: var(--steel) var(--steel-dark) var(--steel-dark) var(--steel);
    border-top-width: 8px; border-top-color: var(--aqua);
}
.card--results { width: 1080px; }
.card__kicker { font-size: 20px; color: var(--aqua-dim); letter-spacing: 2px; }
.card__title { font-size: 52px; color: var(--aqua); margin: 4px 0 12px 0; white-space: normal; }
.card__desc { font-size: 22px; color: #DDEFEB; white-space: normal; margin-bottom: 18px; }
.card__note { font-size: 18px; color: var(--aqua-soft); margin-top: 8px; }
.section {
    font-size: 18px; color: var(--aqua-soft); letter-spacing: 2px;
    margin-top: 14px; margin-bottom: 6px;
    border-bottom-width: 1px; border-bottom-color: var(--aqua-dim); padding-bottom: 3px;
}
.obj-list { }
.obj-row { flex-direction: row; align-items: center; height: 34px; }
.obj-row__dot { width: 16px; height: 16px; border-radius: 3px; margin-right: 12px; }
.obj-row__label { font-size: 22px; color: #DDEFEB; flex-grow: 1; }
.obj-row__count { font-size: 22px; color: var(--aqua); margin-right: 12px; }
.obj-row__mark { width: 26px; height: 26px; }

.buttons { flex-direction: row; justify-content: flex-end; margin-top: 24px; }
.btn {
    font-size: 20px; color: var(--aqua);
    height: 48px; padding: 0 26px; margin-left: 12px;
    background-color: rgba(20, 30, 30, 0.95);
    border-width: 2px; border-radius: 4px;
    border-color: var(--steel) var(--steel-dark) var(--steel-dark) var(--steel);
}
.btn:hover { background-color: rgba(35, 60, 56, 0.95); border-color: var(--aqua); }
.btn--primary { color: #041010; background-color: var(--aqua); border-color: var(--aqua-soft); }
.btn--primary:hover { background-color: var(--aqua-soft); }

/* ---------- results ---------- */
.res-body { flex-direction: row; }
.res-left { width: 300px; align-items: center; justify-content: center; }
.res-right { flex-grow: 1; padding-left: 30px; }
.grade {
    font-size: 220px; color: #9AA0A6;
    -unity-text-align: middle-center;
    scale: 0.2 0.2; opacity: 0;
    transition-property: scale, opacity;
    transition-duration: 0.45s, 0.25s;
    transition-timing-function: ease-out-back, ease-out;
}
.grade--show { scale: 1 1; opacity: 1; }
.grade--A { color: #FFC83D; }
.grade--B { color: #4CE08A; }
.grade--C { color: #4DA6FF; }
.grade--D { color: #9AA0A6; }
.record { font-size: 24px; color: #FFC83D; margin-top: 6px; }
.res-time { font-size: 44px; color: var(--aqua); }
.res-thresholds { font-size: 18px; color: var(--aqua-soft); }
.score-row { flex-direction: row; justify-content: space-between; height: 28px; }
.score-row__label { font-size: 20px; color: #DDEFEB; }
.score-row__value { font-size: 20px; color: var(--aqua); }
.score-row--total .score-row__label, .score-row--total .score-row__value { font-size: 26px; color: var(--aqua); }

/* ---------- tutorial ---------- */
.tutorial {
    position: absolute; top: 90px; left: 0; right: 0;
    align-self: center; align-items: center;
    display: none;
}
.tutorial__step {
    font-size: 18px; color: var(--aqua-dim); letter-spacing: 2px;
    padding: 4px 14px; background-color: var(--black-soft);
    border-top-left-radius: 4px; border-top-right-radius: 4px;
}
.tutorial__text {
    font-size: 30px; color: var(--aqua);
    padding: 12px 28px;
    background-color: var(--black);
    border-width: 2px; border-radius: 4px;
    border-color: var(--steel) var(--steel-dark) var(--steel-dark) var(--steel);
    border-left-width: 6px; border-left-color: var(--aqua);
    -unity-text-align: middle-center;
}
.tutorial__sub { font-size: 22px; color: var(--aqua-soft); margin-top: 6px; padding: 4px 14px; background-color: var(--black-soft); border-radius: 3px; }
.tutorial__skip { font-size: 16px; color: #9AA0A6; margin-top: 8px; }
.tutorial--done .tutorial__text { color: #4CE08A; border-left-color: #4CE08A; }
/* with the analysis panel open the tutorial card moves to the top edge and keeps only the instruction */
.tutorial--inspecting { top: 8px; }
.tutorial--inspecting .tutorial__step,
.tutorial--inspecting .tutorial__sub,
.tutorial--inspecting .tutorial__skip { display: none; }
.tutorial__sub--empty { display: none; }
