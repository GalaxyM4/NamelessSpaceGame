<ui:UXML xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" noNamespaceSchemaLocation="../UIElementsSchema/UIElements.xsd" editor-extension-mode="False">
    <Style src="project://database/Assets/UI%20Toolkit/UiComputer.uss?fileID=7433441132597879392&amp;guid=75c39eb46fa76e44fb77598b9c818cdf&amp;type=3#UiComputer"/>
    <ui:VisualElement class="background">
        <ui:Label text="selecciona una mision" class="main-text" style="width: 100%; color: rgb(255, 255, 255); text-shadow: 20px 20px 0 rgb(0, 0, 0);"/>
        <ui:VisualElement style="flex-grow: 1; flex-direction: row; flex-wrap: wrap; width: 100%; height: 100%; display: flex;">
            <ui:VisualElement name="misionOne" class="card" style="background-color: rgba(0, 0, 0, 0.702); display: none;">
                <ui:Button text="Button" name="FirstMision" class="button-style" style="background-image: url(&quot;project://database/Assets/Materials/marslike01lf.tga?fileID=2800000&amp;guid=31ddc024002c9414988c6a7312552e1d&amp;type=3#marslike01lf&quot;);">
                    <ui:Image name="Image" style="width: 1000px; height: 1000px; background-image: resource(&quot;curiosity-3d-model&quot;); background-size: 80% 60%; align-self: center; justify-content: space-between; align-content: flex-end; flex-wrap: wrap; align-items: flex-start; border-top-width: 4px; border-right-width: 4px; border-bottom-width: 4px; border-left-width: 4px; border-top-left-radius: 20px; border-top-right-radius: 20px; border-bottom-right-radius: 20px; border-bottom-left-radius: 20px;"/>
                </ui:Button>
                <ui:Label text="Misión #1 - La Recolección" name="SecondMision" class="text-general"/>
            </ui:VisualElement>
            <ui:VisualElement name="information" class="card information" style="flex-grow: 1; display: none;">
                <ui:Label text="Información" class="information-text"/>
                <ui:Label text="Desde que aterrizó en el Planeta Rojo en 2021 para buscar señales de vida antigua, el rover Perseverance Mars de la NASA ha recorrido más lejos y más rápido que cualquier vehículo en la superficie de otro mundo. En octubre. 11, su odómetro alcanzó las 28,10 millas (45,22 kilómetros), superando el récord de 28,06 millas (45,16 kilómetros) del rover Opportunity de la NASA (2004-2018). Y Perseverance ha cubierto el terreno en aproximadamente 5½ años, en comparación con casi 15 de su predecesor. Esta misión destaca la recolección de minerales homenajeando este hito en 2021. " class="info-mision" style="width: 100%; -unity-text-align: middle-left; font-size: 48px; white-space: normal;"/>
                <ui:Label text="https://science.nasa.gov/mission/mars-2020-perseverance/" class="text-references"/>
                <ui:Button text="Iniciar misión" name="Button" class="style-button" style="background-image: resource(&quot;frameOne&quot;);"/>
            </ui:VisualElement>
            <ui:VisualElement name="dashboardRight" class="right">
                <ui:VisualElement name="resources-left" class="resources-left">
                    <ui:VisualElement class="frame-resource">
                        <ui:Button text="" name="bobsemple" class="resource-button sprite-bobsemple"/>
                    </ui:VisualElement>
                    <ui:VisualElement class="frame-resource">
                        <ui:Button text="" name="superacerin" class="resource-button sprite-superacerin"/>
                    </ui:VisualElement>
                    <ui:VisualElement class="frame-resource">
                        <ui:Button text="" name="plastimax" class="resource-button sprite-plastimax"/>
                    </ui:VisualElement>
                    <ui:VisualElement class="frame-resource">
                        <ui:Button text="" name="plastimaxII" class="resource-button sprite-plastimax-ii"/>
                    </ui:VisualElement>
                    <ui:VisualElement class="frame-resource">
                        <ui:Button text="" name="aluminium" class="resource-button sprite-aluminium"/>
                    </ui:VisualElement>
                    <ui:VisualElement class="frame-resource">
                        <ui:Button text="" name="fibrividrio" class="resource-button sprite-fibrividrio"/>
                    </ui:VisualElement>
                </ui:VisualElement>
                <ui:VisualElement name="resources-right" class="resources-right">
                    <ui:Label text="RECURSOS" class="resources-title"/>
                    <ui:Label name="selected" text="Selecciona uno" class="resources-subtitle"/>
                    <ui:VisualElement class="resource-stadistic">
                        <ui:Label text="Capacidad:" class="label-stadistic"/>
                        <ui:ProgressBar name="capacity" low-value="0" high-value="35" value="0" title=""/>
                    </ui:VisualElement>
                    <ui:VisualElement class="resource-stadistic">
                        <ui:Label text="Peso:" class="label-stadistic"/>
                        <ui:Label name="weight" text="0Kg" class="label-value"/>
                    </ui:VisualElement>
                    <ui:VisualElement class="resource-stadistic">
                        <ui:Label text="Costo:" class="label-stadistic"/>
                        <ui:Label name="price" text="0.00$" class="label-value"/>
                    </ui:VisualElement>
                    <ui:VisualElement class="resource-stadistic resource-stadistic-actions">
                        <ui:Button name="save" text="Seleccionar" class="button-main"/>
                    </ui:VisualElement>
                </ui:VisualElement>
            </ui:VisualElement>
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
